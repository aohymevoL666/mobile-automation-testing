{
  "name": "eshop-appium-tests",
  "version": "1.0.0",
  "private": true,
  "description": "Appium 2 + WebdriverIO smoke tests for the EShop mobile app",
  "scripts": {
    "appium": "appium",
    "test:smoke": "node test/standalone/calculator.smoke.js",
    "test:eshop": "node test/standalone/eshop-flow.e2e.js",
    "wdio": "wdio",
    "test": "wdio run ./config/wdio.base.conf.js",
    "test:native": "wdio run ./config/wdio.base.conf.js",
    "test:login": "wdio run ./config/suites/login.conf.js",
    "test:bugs": "wdio run ./config/suites/bugs.conf.js",
    "test:cart": "wdio run ./config/suites/cart.conf.js",
    "test:srs": "wdio run ./config/suites/srs.conf.js",
    "test:ai": "wdio run ./config/suites/ai.conf.js"
  },
  "devDependencies": {
    "@wdio/cli": "^9.29.1",
    "@wdio/local-runner": "^9.29.1",
    "@wdio/mocha-framework": "^9.29.1",
    "@wdio/spec-reporter": "^9.29.1",
    "appium": "^3.5.2",
    "appium-uiautomator2-driver": "^8.1.1",
    "webdriverio": "^9.30.0"
  }
}
